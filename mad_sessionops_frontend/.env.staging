# Staging Environment — dev.sessionops.makeadiff.in
# These are baked into the JS bundle at build time via docker build args.
# Update docker-compose.staging.yml if you change these URLs.

# API Configuration
NEXT_PUBLIC_API_URL=https://dev.sessionops.makeadiff.in/api
NEXT_PUBLIC_API_TIMEOUT=30000

# App Configuration
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_URL=https://dev.sessionops.makeadiff.in

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_MOCK_API=false

# Logging
NEXT_PUBLIC_LOG_LEVEL=info

# Google OAuth (same client ID as dev — add staging domain to authorized origins in GCP)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=665756451396-rgnaukah8oid76hfvdfct7m8dokmsjjd.apps.googleusercontent.com

# Sentry (leave blank to disable; SDK no-ops with no DSN)
NEXT_PUBLIC_SENTRY_DSN=https://497f7b06c90e89de72d46967e2724b3e@o4511930701512704.ingest.us.sentry.io/4511930753941504
