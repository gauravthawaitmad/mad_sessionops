# Production Environment Configuration

# API Configuration
NEXT_PUBLIC_API_URL=https://api.madplatform.com/api
NEXT_PUBLIC_API_TIMEOUT=10000

# App Configuration
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://madplatform.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false
NEXT_PUBLIC_ENABLE_MOCK_API=false

# Logging
NEXT_PUBLIC_LOG_LEVEL=error

# Performance
NEXT_PUBLIC_ENABLE_SW=true
NEXT_PUBLIC_CACHE_MAX_AGE=3600

# Sentry (leave blank to disable; SDK no-ops with no DSN)
NEXT_PUBLIC_SENTRY_DSN=https://497f7b06c90e89de72d46967e2724b3e@o4511930701512704.ingest.us.sentry.io/4511930753941504
