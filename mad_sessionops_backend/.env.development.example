# Copy this file to .env.development and fill in real values.
# NEVER commit .env.development to git.

# Django
DJANGOSECRET=change-me-use-django-get-random-secret-key
DEBUG=True
ENVIRONMENT=development

# Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Database (PostgreSQL)
DBNAME=mad_dev
DBHOST=localhost
DBPORT=5432
DBUSER=postgres
DBPASSWORD=change-me
DBSCHEMA=mad_platform_dev
DBADMINUSER=postgres
DBADMINPASSWORD=change-me

# JWT
JWT_SECRET_KEY=change-me-use-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRY_HOURS=12
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_V2=http://localhost:3001

# Redis + Celery
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Sentry (leave blank to disable)
SENTRY_DSN=
SENTRY_TSR=1.0
SENTRY_PSR=1.0
SENTRY_ENABLE_LOGS=True
SENTRY_SEND_DEFAULT_PII=False

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Brevo (transactional email — password reset, set-password welcome)
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-v3-api-key-here
BREVO_FROM_EMAIL=noreply@sessionops.makeadiff.in
BREVO_FROM_NAME=Session-Ops

# Hasura (sync service — M1 and later)
HASURA_API_BASE_URL=https://hasura.makeadiff.in
HASURA_API_JWT=<long-lived-service-jwt-from-hasura>

# M7 migration loader endpoints (/api/internal/migrate/*) — separate token from
# INTERNAL_SYNC_SERVICE_TOKEN (M8a); a leaked one must not grant the other's access.
MIGRATION_SERVICE_TOKEN=<generate-a-random-token>
