# Backend staging environment — dev.sessionops.makeadiff.in
# Copy to .env.staging on the EC2 instance and fill in real values.
# NEVER commit .env.staging to git.

# Django
DJANGOSECRET=generate-with-python-c-"import secrets;print(secrets.token_hex(50))"
DEBUG=False
ENVIRONMENT=staging

# Hosts & CORS
ALLOWED_HOSTS=dev.sessionops.makeadiff.in,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://dev.sessionops.makeadiff.in,http://localhost
FRONTEND_URL=https://dev.sessionops.makeadiff.in
FRONTEND_URL_V2=https://dev.sessionops.makeadiff.in

# Database — point to the RDS instance
DBNAME=mad_staging
DBHOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DBPORT=5432
DBUSER=your-db-user
DBPASSWORD=your-db-password
DBSCHEMA=mad_sessionops_staging

# JWT
JWT_SECRET_KEY=generate-with-python-c-"import secrets;print(secrets.token_hex(50))"
JWT_ACCESS_TOKEN_EXPIRY_HOURS=12
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Redis — Docker service name (overridden by docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Sentry
SENTRY_DSN=your-sentry-dsn
SENTRY_TSR=0.2
SENTRY_PSR=0.2
SENTRY_ENABLE_LOGS=True
SENTRY_SEND_DEFAULT_PII=False

# Email / Brevo
EMAIL_BACKEND=sessionops.services.email_service.BrevoEmailBackend
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=noreply@sessionops.makeadiff.in
BREVO_FROM_NAME=Session-Ops

# Hasura
HASURA_API_BASE_URL=https://hasura.makeadiff.in
HASURA_API_JWT=your-hasura-service-jwt




MIGRATION_SERVICE_TOKEN=<generate-a-random-token>

# Internal partner-sync trigger endpoint — called by the n8n scheduler in place of
# the crontab entry. Separate token from INTERNAL_SYNC_SERVICE_TOKEN and
# MIGRATION_SERVICE_TOKEN for the same reason: a leaked one must not grant the
# others' access. Path is deliberately non-guessable, same as INTERNAL_SYNC_ENDPOINT_PATH.
PARTNER_SYNC_SERVICE_TOKEN=<generate-a-random-token>
PARTNER_SYNC_ENDPOINT_PATH=/sync-partner-internal
