# Flake8 configuration for MAD Backend

[flake8]
# Maximum line length
max-line-length = 200

# Maximum cyclomatic complexity
# 20, not the usual 15 default — several service-layer functions (edit_child,
# enroll_child, reactivate_child, migrate_row, edit_slot_class) are naturally
# branchy because they enforce multiple sequential business rules; refactoring
# them purely to hit a lower complexity score risks introducing a real bug.
max-complexity = 20

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .tox,
    migrations,
    node_modules,
    staticfiles,
    media

# Ignore specific errors
# E203: whitespace before ':' (conflicts with black)
# E266: too many leading '#' for block comment
# E501: line too long (handled by black)
# W503: line break before binary operator
# W504: line break after binary operator
# E402: module level import not at top of file
# F401: imported but unused (sometimes needed)
# E221/E222/E241: pycodestyle misreads aligned '=' in model field declarations
#   and colons/semicolons inside multi-line HTML/CSS f-strings (email
#   templates, admin.py) as spacing-around-operator violations.
# E231/E702: same root cause — colons/semicolons inside f-string/HTML content
#   (e.g. inline CSS "style=\"color:red;\"") are not Python statement
#   separators; pycodestyle's tokenizer doesn't distinguish them from real code.
# E713: also a string-content false positive (e.g. matches the English phrase
#   "not found in" inside an error message, not an actual `not x in y` test).
ignore =
    E203,
    E266,
    E501,
    W503,
    W504,
    E402,
    F401,
    E221,
    E222,
    E231,
    E241,
    E702,
    E713

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    settings.py:E501
    */migrations/*.py:E501

# Show source code for each error
show-source = True

# Show pep8 violation statistics
statistics = True

# Count errors
count = True

# Enable/disable specific checks
select = E,W,F,C

# Format of the error message
format = %(path)s:%(row)d:%(col)d: %(code)s %(text)s

