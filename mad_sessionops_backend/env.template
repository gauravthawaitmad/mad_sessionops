# Django Settings
DJANGOSECRET=your-secret-key-here-change-in-production
DEBUG=True
ENVIRONMENT=development

# Database
DBNAME=mad_backend
DBHOST=localhost
DBPORT=5432
DBUSER=postgres
DBPASSWORD=your-password-here
DBSCHEMA=your-schema-here
DBADMINUSER=postgres
DBADMINPASSWORD=your-password-here

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRY_HOURS=12
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Google OAuth Settings
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS Settings
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_V2=http://localhost:3001

# Sentry Settings (optional)
SENTRY_DSN=
SENTRY_TSR=1.0
SENTRY_PSR=1.0
SENTRY_ENABLE_LOGS=True
SENTRY_SEND_DEFAULT_PII=True

# Email Settings (if needed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# API Settings
API_RATE_LIMIT=1000/hour

# Static Files
STATIC_URL=/static/
STATIC_ROOT=staticfiles/
MEDIA_URL=/media/
MEDIA_ROOT=media/
