# Pylint configuration for MAD Backend
# Following Dalgo backend best practices

[MASTER]
# Use multiple processes to speed up Pylint
jobs=4

# Pickle collected data for later comparisons
persistent=yes

# List of plugins (as comma separated values of python module names)
load-plugins=pylint_django

# Django settings module
django-settings-module=sessionops.settings

# Generated code — migrations are Django-authored boilerplate, not
# hand-written logic; duplicate-code/line-length findings there are noise.
ignore-paths=.*/migrations/.*

[MESSAGES CONTROL]
# Disable specific messages
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-instance-attributes,
    logging-not-lazy,
    logging-fstring-interpolation,
    broad-exception-raised,
    broad-exception-caught,
    fixme,
    line-too-long,
    invalid-name,
    no-member

# Enable specific messages
enable=
    useless-suppression,
    deprecated-pragma

[REPORTS]
# Set the output format
output-format=colorized

# Reports score
score=yes

# Minimum score to pass (0-10)
fail-under=6.5

[BASIC]
# Good variable names
good-names=i,j,k,ex,Run,_,id,pk,db

# Regular expressions for variable naming
argument-rgx=[a-z_][a-z0-9_]{2,30}$
attr-rgx=[a-z_][a-z0-9_]{2,30}$
variable-rgx=[a-z_][a-z0-9_]{2,30}$
class-attribute-rgx=([A-Za-z_][A-Za-z0-9_]{2,30}|(__.*__))$
method-rgx=[a-z_][a-z0-9_]{2,30}$
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$
class-rgx=[A-Z_][a-zA-Z0-9]+$
function-rgx=[a-z_][a-z0-9_]{2,30}$
module-rgx=(([a-z_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]+))$

[FORMAT]
# Maximum number of characters on a single line
max-line-length=200

# Maximum number of lines in a module
max-module-lines=1000

# String used as indentation unit (4 spaces)
indent-string='    '

# Expected format of line ending
expected-line-ending-format=LF

[LOGGING]
# Format style used to check logging format string.
# "old" (%-style), not "new" ({}-style) — this codebase uses %-style lazy
# logging throughout (the correct, recommended stdlib pattern). Under "new",
# pylint doesn't recognize %d/%s as placeholders and flags every logger.info()
# call with args as logging-too-many-args, which is a false positive, not a
# real bug — verified by reproducing it against a trivial one-line log call.
logging-format-style=old

[SIMILARITIES]
# Minimum lines number of a similarity
min-similarity-lines=4

# Ignore comments when computing similarities
ignore-comments=yes

# Ignore docstrings when computing similarities
ignore-docstrings=yes

# Ignore imports when computing similarities
ignore-imports=yes

[TYPECHECK]
# List of decorators that produce context managers
contextmanager-decorators=contextlib.contextmanager

# List of members which are set dynamically
generated-members=objects,DoesNotExist,id,pk,_meta,MultipleObjectsReturned

# List of classes to ignore
ignored-classes=optparse.Values,thread._local,_thread._local

[DESIGN]
# Maximum number of arguments for function / method
max-args=7

# Maximum number of locals for function / method body
max-locals=15

# Maximum number of return / yield for function / method body
max-returns=6

# Maximum number of branch for function / method body
max-branches=12

# Maximum number of statements in function / method body
max-statements=50

# Maximum number of parents for a class
max-parents=7

# Maximum number of attributes for a class
max-attributes=10

# Minimum number of public methods for a class
min-public-methods=0

# Maximum number of public methods for a class
max-public-methods=20

[IMPORTS]
# Deprecated modules which should not be used
deprecated-modules=optparse,tkinter.tix

[CLASSES]
# List of method names used to declare instance attributes
defining-attr-methods=__init__,__new__,setUp,__post_init__

# List of valid names for the first argument in a class method
valid-classmethod-first-arg=cls

# List of valid names for the first argument in a metaclass class method
valid-metaclass-classmethod-first-arg=mcs

[EXCEPTIONS]
# Exceptions that will emit a warning when being caught
overgeneral-exceptions=builtins.Exception

