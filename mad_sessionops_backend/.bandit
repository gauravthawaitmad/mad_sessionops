# Bandit configuration for security scanning
# Bandit's -c config file must be valid YAML, not INI — this file used INI-style
# `[bandit]` / `key = value` syntax, which crashed bandit's YAML parser
# ("expected '<document start>', but found '<scalar>'") before it ever ran a
# single check.

exclude_dirs:
  - "/test"
  - "tests"
  - ".venv"
  - "venv"
  - "migrations"

# Tests to skip (everything else runs — the old config's explicit `tests:`
# whitelist included B309, which doesn't exist in the installed bandit==1.7.5
# and made bandit refuse to start at all: "Unknown test found in profile").
skips:
  - B101  # assert_used
  - B601  # paramiko_calls
