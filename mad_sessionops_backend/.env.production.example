# Backend production environment.
# Copy to .env.production on the production EC2 instance and fill in real values.
# NEVER commit .env.production to git.
#
# Every value here must be FRESH and DISTINCT from staging's — see the inline
# notes below for which ones must never be reused across environments.

# Django
DJANGOSECRET=generate-with-python-c-"import secrets;print(secrets.token_hex(50))"
DEBUG=False
ENVIRONMENT=production

# Hosts & CORS — placeholder until the real domain is released; update both
# this file and the nginx config together when it lands (see ops/nginx/).
ALLOWED_HOSTS=sessionops.makeadiff.in,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://sessionops.makeadiff.in
FRONTEND_URL=https://sessionops.makeadiff.in
FRONTEND_URL_V2=https://sessionops.makeadiff.in

# Database — a separate DBNAME/DBSCHEMA from staging at minimum (this repo's
# convention: mad_staging/mad_sessionops_staging for staging), ideally a
# dedicated DB user too, not shared with staging/dev credentials.
DBNAME=mad_prod
DBHOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DBPORT=5432
DBUSER=your-db-user
DBPASSWORD=your-db-password
DBSCHEMA=mad_sessionops_production
# Used once by entrypoint.sh to create the schema + grant it to DBUSER on
# first boot — falls back to DBUSER/DBPASSWORD if unset, but a real admin
# credential here is safer than granting DBUSER schema-creation rights.
DBADMINUSER=postgres
DBADMINPASSWORD=your-admin-password

# JWT — generate fresh; a token signed with staging's key must never be
# accepted here or vice versa.
JWT_SECRET_KEY=generate-with-python-c-"import secrets;print(secrets.token_hex(50))"
JWT_ACCESS_TOKEN_EXPIRY_HOURS=12
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Google OAuth — confirm the production domain's redirect URI is registered
# on this client in Google Cloud Console before go-live (same client as
# staging is fine as long as all environments' redirect URIs are listed on
# it; a dedicated production client is also a reasonable choice).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Redis — Docker service name (overridden by docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Sentry — either a dedicated production project, or the same project as
# staging relying on the ENVIRONMENT tag (sessionops.settings passes
# environment=ENVIRONMENT to sentry_sdk.init) to separate the two in the UI.
# Lower sample rates than dev/staging are typical for production traffic volume.
SENTRY_DSN=your-sentry-dsn
SENTRY_TSR=0.1
SENTRY_PSR=0.1
SENTRY_ENABLE_LOGS=True
SENTRY_SEND_DEFAULT_PII=False

# Email / Brevo — BREVO_FROM_EMAIL must be a sender Brevo actually has
# domain/DKIM authentication for. noreply@sessionops.makeadiff.in specifically
# does NOT have that today (only the root makeadiff.in domain does — see the
# Brevo sender-authentication issue diagnosed for staging); confirm this before
# go-live or password-reset emails will silently fail exactly like staging did.
EMAIL_BACKEND=sessionops.services.email_service.BrevoEmailBackend
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=noreply@sessionops.makeadiff.in
BREVO_FROM_NAME=Session-Ops

# Hasura
HASURA_API_BASE_URL=https://hasura.makeadiff.in
HASURA_API_JWT=your-hasura-service-jwt

# Internal sync endpoints — realtime user sync (M8a), called by Hasura's
# event trigger / n8n. Fresh token + path, never reused from staging.
INTERNAL_SYNC_SERVICE_TOKEN=<generate-a-random-token>
INTERNAL_SYNC_ENDPOINT_PATH=/sync-user-internal

# One-off data migration endpoint (M7). Fresh token, never reused from staging.
MIGRATION_SERVICE_TOKEN=<generate-a-random-token>

# Internal partner-sync trigger endpoint — called by the n8n scheduler.
# Fresh token + path, never reused from staging.
PARTNER_SYNC_SERVICE_TOKEN=<generate-a-random-token>
PARTNER_SYNC_ENDPOINT_PATH=/sync-partner-internal

# Fresh token + path, never reused from staging.
PARTNER_WORKNODE_SYNC_SERVICE_TOKEN=<generate-a-random-token>
PARTNER_WORKNODE_SYNC_ENDPOINT_PATH=/sync-partner-worknode-internal
