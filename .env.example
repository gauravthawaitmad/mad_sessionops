# Root-level .env — read by docker compose for variable substitution.
# Copy to .env and fill in real values. NEVER commit .env.
#
# This file only needs vars that aren't already in backend/.env.development
# (i.e., vars used in docker-compose.yml build args).

# Google OAuth Client ID (public — same value as in frontend/.env.development)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
