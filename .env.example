# Root .env — read by docker compose for variable substitution.
# Copy to .env and fill in. NEVER commit .env.
#
# BACKEND_ENV_FILE controls which backend env file is loaded.
# This avoids docker compose merging multiple env_file arrays.

# Local dev (default if not set):
# BACKEND_ENV_FILE=./mad_sessionops_backend/.env.development

# Local staging test:
# BACKEND_ENV_FILE=./mad_sessionops_backend/.env.staging

# EC2 staging:
BACKEND_ENV_FILE=./mad_sessionops_backend/.env.staging

# Google OAuth Client ID (public — same value used as build arg for frontend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
